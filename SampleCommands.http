### Sample GraphQL Queries and Mutations

### Simple Query
GRAPHQL http://localhost:8080/graphql

query SimpleQuery {
    greeting(name: "GraphQL")
}

### Get All Widgets
GRAPHQL http://localhost:8080/graphql

query GetAllWidgets {
    GetWidgets {
        id
        name
        price
        quantity
    }
}

### Get Widget by ID
GRAPHQL http://localhost:8080/graphql

query GetWidget($id: Int!) {
    GetWidget(id: $id) {
        id
        name
        price
        quantity
    }
}

{
  "id": 1
}

### Create Widget
GRAPHQL http://localhost:8080/graphql

mutation CreateWidget($widget: WidgetCreateInput!) {
    CreateWidget(widget: $widget) {
        id
        name
        price
        quantity
    }
}

{
  "widget": {
    "name": "New Widget",
    "price": 19.99,
    "quantity": 100
  }
}

### Update Widget
GRAPHQL http://localhost:8080/graphql

mutation UpdateWidget($widget: Widget!) {
    UpdateWidget(widget: $widget) {
        id
        name
        price
        quantity
    }
}

{
  "widget": {
    "id": 1,
    "name": "Updated Widget",
    "price": 29.99,
    "quantity": 50
  }
}

### Get All Employees (Interface Example)
GRAPHQL http://localhost:8080/graphql

query GetAllEmployees {
    GetAllEmployees {
        ... on Developer {
            id
            name
            email
            salary
            hireDate
            programmingLanguages
            githubUsername
        }
        ... on Manager {
            id
            name
            email
            salary
            hireDate
            department
            teamSize
            reports {
                ... on Developer {
                    name
                    programmingLanguages
                }
            }
        }
    }
}

### Get All Employees with Type Discovery (New Approach)
# This demonstrates the new type discovery system - GetAllEmployees returns Employee interface
# but we can discover the actual type (Developer or Manager) at runtime
GRAPHQL http://localhost:8080/graphql

query GetAllEmployeesWithTypeDiscovery {
    GetAllEmployees {
        __typename
        ID
        Name
        Email
        Salary
        HireDate
        ... on Developer {
            ProgrammingLanguages
            GithubUsername
        }
        ... on Manager {
            Department
            TeamSize
        }
    }
}

### Get Specific Employee with Type Discovery
# GetEmployee now returns Employee interface, actual type discoverable at runtime
GRAPHQL http://localhost:8080/graphql

query GetEmployeeWithTypeDiscovery($id: Int!) {
    GetEmployee(id: $id) {
        __typename
        ID
        Name
        Email
        Salary
        HireDate
        # Developer-specific fields
        ... on Developer {
            ProgrammingLanguages
            GithubUsername
        }
        # Manager-specific fields
        ... on Manager {
            Department
            TeamSize
            Reports {
                __typename
                ID
                Name
                ... on Developer {
                    ProgrammingLanguages
                }
            }
        }
    }
}

{
  "id": 2
}

### Test Type Discovery with Different Employee IDs
# ID 1 is John Doe (Developer), ID 2 is Jane Smith (Manager), ID 3 is Bob Wilson (Developer)
GRAPHQL http://localhost:8080/graphql

query TestMultipleEmployees {
    developer: GetEmployee(id: 1) {
        __typename
        ... on Developer {
            Name
            ProgrammingLanguages
            GithubUsername
        }
    }
    manager: GetEmployee(id: 2) {
        __typename
        ... on Manager {
            Name
            Department
            TeamSize
            Reports {
                __typename
                ID
                Name
            }
        }
    }
}

### Create Employee (Union Type Example)
GRAPHQL http://localhost:8080/graphql

mutation CreateEmployees {
    developer: CreateEmployee(input: {
        name: "Alice Developer"
        email: "alice@example.com"
        salary: 110000
        type: DEVELOPER
        programmingLanguages: ["TypeScript", "React", "Node.js"]
        githubUsername: "alice-dev"
    }) {
        __typename
        ... on Developer {
            ID
            Name
            Email
            ProgrammingLanguages
            GithubUsername
        }
    }
    
    manager: CreateEmployee(input: {
        name: "Bob Manager"
        email: "bob@example.com"
        salary: 130000
        type: MANAGER
        department: "Product"
        programmingLanguages: []
    }) {
        __typename
        ... on Manager {
            ID
            Name
            Email
            Department
            TeamSize
        }
    }
}

### Promote Developer to Manager
GRAPHQL http://localhost:8080/graphql

mutation PromoteToManager($employeeId: Int!, $department: String!) {
    PromoteToManager(employeeId: $employeeId, department: $department) {
        id
        name
        email
        salary
        department
        teamSize
    }
}

{
  "employeeId": 3,
  "department": "DevOps"
}

### Search (Union Type Example)
GRAPHQL http://localhost:8080/graphql

query Search($query: String!) {
    Search(query: $query) {
        __typename
        ... on Widget {
            id
            name
            price
        }
        ... on Product {
            id
            name
            description
            price
        }
        ... on Developer {
            name
            email
            programmingLanguages
        }
        ... on Manager {
            name
            email
            department
        }
    }
}

{
  "query": "laptop"
}

### Get Products with Complex Nested Queries
GRAPHQL http://localhost:8080/graphql

query GetProducts {
    GetProducts(filter: {
        minPrice: 20
        maxPrice: 1000
        status: ACTIVE
        inStock: true
    }) {
        id
        name
        description
        price
        status
        inStock
        category {
            id
            name
            description
        }
        reviews {
            id
            rating
            comment
            createdAt
            user {
                username
                email
                role
            }
        }
        averageRating
    }
}

### Create Product
GRAPHQL http://localhost:8080/graphql

mutation CreateProduct($input: ProductInput!) {
    CreateProduct(input: $input) {
        id
        name
        description
        price
        status
        inStock
        category {
            name
        }
    }
}

{
  "input": {
    "name": "GraphQL Book",
    "description": "A comprehensive guide to GraphQL",
    "price": 49.99,
    "categoryId": 2
  }
}

### Add Product Review
GRAPHQL http://localhost:8080/graphql

mutation AddReview($productId: Int!, $review: ReviewInput!) {
    AddProductReview(productId: $productId, review: $review) {
        id
        rating
        comment
        createdAt
        user {
            username
        }
    }
}

{
  "productId": 1,
  "review": {
    "rating": 5,
    "comment": "Excellent laptop! Very fast and reliable."
  }
}

### Get Categories with Products
GRAPHQL http://localhost:8080/graphql

query GetCategoriesWithProducts {
    GetCategories {
        id
        name
        description
        products {
            id
            name
            price
            status
            inStock
        }
    }
}

### Complex Employee Query with Personal Details
# Note: PersonalDetails requires authentication (Bearer token)
GRAPHQL http://localhost:8080/graphql
Authorization: Bearer admin-token

query GetEmployeeWithPersonalDetails($id: Int!) {
    GetEmployee(id: $id) {
        __typename
        ID
        Name
        Email
        PersonalDetails {
            phoneNumber
            address
            salary
            email
        }
        ... on Manager {
            Department
            TeamSize
        }
    }
}

{
  "id": 2
}

### Admin Create Product (Auth Required)
GRAPHQL http://localhost:8080/graphql
Authorization: Bearer admin-token

mutation AdminCreateProduct($input: ProductInput!) {
    AdminCreateProduct(input: $input) {
        id
        name
        status
        price
    }
}

{
  "input": {
    "name": "Premium Product",
    "description": "A premium product only admins can create",
    "price": 999.99,
    "categoryId": 1
  }
}

### WebSocket Subscription Example (use ws://localhost:8080/graphql)
subscription WidgetUpdates($widgetId: Int!) {
    widgetUpdates(widgetId: $widgetId) {
        action
        timestamp
        widget {
            id
            name
            price
            quantity
        }
    }
}

{
  "widgetId": 1
}

### Product Updates Subscription
subscription ProductUpdates($categoryId: Int!) {
    productUpdates(categoryId: $categoryId) {
        action
        timestamp
        product {
            id
            name
            price
            status
        }
    }
}

{
  "categoryId": 1
}

### Current Time Subscription
subscription CurrentTime {
    currentTime(intervalMs: 1000) {
        timestamp
        formatted
    }
}

### Order Status Updates Subscription
subscription OrderStatus($orderId: String!) {
    orderStatusUpdates(orderId: $orderId) {
        orderId
        status
        message
        timestamp
    }
}

{
  "orderId": "ORDER-123"
}

### Multiple Queries in One Request
GRAPHQL http://localhost:8080/graphql

query MultipleQueries {
    widgets: GetWidgets {
        id
        name
        price
    }
    
    employees: GetAllEmployees {
        __typename
        ID
        Name
        ... on Developer {
            ProgrammingLanguages
        }
        ... on Manager {
            Department
        }
    }
    
    categories: GetCategories {
        id
        name
    }
}

### Introspection Query - Get All Types
GRAPHQL http://localhost:8080/graphql

query IntrospectionQuery {
    __schema {
        types {
            name
            kind
            description
        }
    }
}

### Introspection - Get Employee Type Details
GRAPHQL http://localhost:8080/graphql

query EmployeeTypeDetails {
    __type(name: "Employee") {
        name
        kind
        interfaces {
            name
        }
        possibleTypes {
            name
        }
        fields {
            name
            type {
                name
                kind
            }
        }
    }
}

### Custom Scalar Examples ###

### Validate Email Address
GRAPHQL http://localhost:8080/graphql

query ValidateEmail($email: EmailAddress!) {
    validateEmail(email: $email)
}

{
  "email": "user@example.com"
}

### Get Current Date/Time
GRAPHQL http://localhost:8080/graphql

query GetCurrentDateTime {
    getCurrentDateTime
}

### Process JSON Metadata
GRAPHQL http://localhost:8080/graphql

mutation ProcessMetadata($metadata: JSON!) {
    processJSONMetadata(metadata: $metadata)
}

{
  "metadata": {
    "version": "1.0",
    "features": ["auth", "caching", "logging"],
    "config": {
      "timeout": 30,
      "retries": 3
    }
  }
}

### Create Product with Custom Scalars
GRAPHQL http://localhost:8080/graphql

mutation CreateColoredProduct($name: String!, $price: Money!, $color: HexColor!) {
    createColoredProduct(
        name: $name,
        price: $price,
        color: $color
    ) {
        id
        name
        price
        color
    }
}

{
    "name": "Emerald Green Gadget",
    "price": "45.00 EUR",
    "color": "#00FF00"
}

### Get Employee by Custom ID Scalar
GRAPHQL http://localhost:8080/graphql

query GetEmployeeByScalarID {
    getEmployeeByIDScalar(id: "1") {
        ID
        Name
        Email
    }
}

### Get Server Start Time (DateTime Scalar)
GRAPHQL http://localhost:8080/graphql

query GetServerStartTime {
    getServerStartTime
}

### Multiple Scalar Examples in One Query
GRAPHQL http://localhost:8080/graphql

query MultipleScalarExamples {
    validateEmail(email: "test@domain.com")
    getServerStartTime
}

### Custom Scalar Schema Introspection
GRAPHQL http://localhost:8080/graphql

query CustomScalarIntrospection {
    emailAddress: __type(name: "EmailAddress") {
        name
        kind
        description
    }
    dateTime: __type(name: "DateTime") {
        name
        kind
        description
    }
    money: __type(name: "Money") {
        name
        kind
        description
    }
}

### Create Product with JSON Metadata
GRAPHQL http://localhost:8080/graphql

mutation CreateProductWithMetadata($name: String!, $price: Money!, $metadata: JSON!) {
    createProductWithMetadata(
        name: $name,
        price: $price,
        metadata: $metadata
    ) {
        id
        name
        price
        metadata
    }
}

{
  "name": "Advanced Smart Device",
  "price": "199.99 CAD",
  "metadata": {
    "category": "Electronics",
    "tags": ["smart", "wireless", "premium"],
    "technical": {
      "cpu": "ARM Cortex-M4",
      "memory": "256KB",
      "connectivity": ["WiFi", "Bluetooth 5.0"]
    },
    "warranty": "2 years",
    "energyRating": "A++",
    "certified": true
  }
}

### VALIDATION TEST CASES ###

### Test Employee Input Validation - Missing Name
GRAPHQL http://localhost:8080/graphql

mutation CreateEmployeeInvalidNoName {
    CreateEmployee(input: {
        name: ""
        email: "test@example.com"
        salary: 50000
        type: DEVELOPER
        programmingLanguages: ["Go"]
    }) {
        __typename
        ... on Developer {
            ID
            Name
        }
    }
}

