GRAPHQL http://localhost:8080/graphql
Authorization: Bearer admin-token

mutation PromoteWithAdminAuth {
    PromoteToManager(input: {
        employeeId: 1
        department: "Engineering"
    }) {
        id
        name
        department
    }
}

