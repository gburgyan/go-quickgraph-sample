### Test Context Validation - Promote Without Auth
# This should fail because no authentication token is provided
GRAPHQL http://localhost:8080/graphql

mutation PromoteWithoutAuth {
    PromoteToManager(input: {
        employeeId: 1
        department: "Engineering"
    }) {
        id
        name
        department
    }
}

### Test Context Validation - Promote With Non-Admin Auth
# This should fail because only admins can promote
GRAPHQL http://localhost:8080/graphql
Authorization: Bearer user-token

mutation PromoteWithUserAuth {
    PromoteToManager(input: {
        employeeId: 1
        department: "Engineering"
    }) {
        id
        name
        department
    }
}

